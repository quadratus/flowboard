# Local development values only. These are not secrets.
POSTGRES_USER=flowboard
POSTGRES_PASSWORD=flowboard
POSTGRES_DB=flowboard

# Host ports that docker compose publishes.
DB_PORT=5432
API_PORT=3000
WEB_PORT=8080

# Used by `pnpm dev` on the host. The api container builds its own URL in compose.yaml.
DATABASE_URL=postgres://flowboard:flowboard@localhost:5432/flowboard
