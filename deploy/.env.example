# Copy to deploy/.env on the server and set real values. deploy/.env is not in git.
# Generate strong values with: openssl rand -base64 24

# Password barrier in front of the whole app (nginx basic auth).
BASIC_AUTH_USER=reviewer
BASIC_AUTH_PASSWORD=

# Postgres password. Only the API container uses it; Postgres has no published port.
POSTGRES_PASSWORD=

# nginx listens on 127.0.0.1 only. The tunnel forwards to this port.
WEB_PORT=8090
